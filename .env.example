# -----------------------------------------------------------------------------
# SECRETS GENERATION COMMANDS
# To generate a new AUTH_SECRET (32-byte base64):
# run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# To generate a new ADMIN_PASSWORD hash using bcrypt:
# run: node -e "const bcrypt = require('bcrypt'); console.log(bcrypt.hashSync('YourNewPassword', 12).replaceAll('$', '\\\\$'));"
#
# To generate a new REVALIDATION_TOKEN (24-byte hex):
# run: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# -----------------------------------------------------------------------------

AUTH_SECRET=
ADMIN_USERNAME=

# Password currently set to: ""
# Replace with the generated bcrypt hash from the command above.
# Note: Next.js uses dotenv-expand, so you MUST escape the dollar signs with backslashes!
ADMIN_PASSWORD=

REVALIDATION_TOKEN=
NEXT_PUBLIC_APP_URL=

NEXTAUTH_URL=
NEXTAUTH_SECRET=


AUTH_DISCORD_SECRET=
AUTH_DISCORD_ID=
